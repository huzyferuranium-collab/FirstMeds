# Copy to .env (or set in your host's dashboard). Never commit real secrets.
NODE_ENV=production
PORT=4000
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Where the SQLite database lives (mount a persistent volume here)
DATABASE_PATH=/data/firstmeds.db
# First HQ admin, created only when the database is empty
ADMIN_EMAIL=admin@firstmeds.ug
ADMIN_PASSWORD=
# Set to 1 to also load demo facilities and sales on first start
SEED_DEMO=0
# Africa's Talking SMS for refill reminders (optional; without these SMS are logged only)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
